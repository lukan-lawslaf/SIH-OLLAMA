# Default model when the client does not request one explicitly.
QWEN_MODEL=qwen3-vl:4b

# Models the client is allowed to switch to (comma separated).
# Primary demo models: qwen3-vl:2b and qwen3-vl:4b (local).
# Test model: qwen3-vl:235b-cloud (runs via Ollama cloud; requires `ollama signin`).
QWEN_ALLOWED_MODELS=qwen3-vl:2b,qwen3-vl:4b,qwen3-vl:235b-cloud

# Local Ollama daemon.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Alternative backend (any OpenAI-compatible server, e.g. vLLM) ---
# QWEN_BACKEND=openai
# QWEN_BASE_URL=http://127.0.0.1:8001/v1
# QWEN_API_KEY=local

# CORS origins. "*" is fine for the demo; restrict for hardened setups.
ALLOWED_ORIGINS=*
