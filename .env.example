# Default model when the client does not request one explicitly.
QWEN_MODEL=qwen3-vl:4b

# Models the client is allowed to switch to (comma separated).
#   Primary demo models : qwen3-vl:2b, qwen3-vl:4b        (local)
#   Test matrix         : qwen3.5:2b, qwen3.5:4b          (local)
#                         qwen3-vl:235b-cloud, gemma4:31b-cloud
#                         (Ollama cloud — requires `ollama signin`)
# Add or remove tags here to make a model testable; restart the gateway.
QWEN_ALLOWED_MODELS=qwen3-vl:2b,qwen3-vl:4b,qwen3-vl:235b-cloud,qwen3.5:2b,qwen3.5:4b,gemma4:31b-cloud

# True plug-and-play: forward ANY client-requested model id to the backend
# (LAN demo convenience — test any tag without editing this file).
# Keep false for a strict allow-list.
ALLOW_ANY_MODEL=false

# Local Ollama daemon.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Reasoning-effort knob injected into Ollama-bound requests.
# Thinking models (gemma4, qwen3.5, ...) burn the client's max_tokens budget on
# reasoning before any content — planner JSON arrives empty/truncated.
#   none        = disable thinking everywhere (deterministic, fastest)
#   passthrough = leave the client request untouched (model default)
#   low/medium/high = force thinking on at that effort level
OLLAMA_REASONING_EFFORT=passthrough

# --- Alternative backend (any OpenAI-compatible server, e.g. vLLM) ---
# QWEN_BACKEND=openai
# QWEN_BASE_URL=http://127.0.0.1:8001/v1
# QWEN_API_KEY=local

# CORS origins. "*" is fine for the demo; restrict for hardened setups.
ALLOWED_ORIGINS=*
